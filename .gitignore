# ---------- Variables de entorno ----------
# Se ignora todo archivo de entorno salvo los de ejemplo.
.env
.env.*
!.env.ejemplo
!.env.*.ejemplo
!*.env.ejemplo

# ---------- Configuracion local de editores ----------
# Se ignora la configuracion local de VS Code, pero se versionan los archivos
# compartidos del taller. La exclusion usa .vscode/* y no .vscode/ porque git no
# desciende a un directorio excluido y las negaciones no tendrian efecto.
.vscode/*
!.vscode/extensions.json
!.vscode/mcp.json
.idea/
*.iml
*.ipr
*.iws
.fleet/
.eclipse/
.settings/
.project
.classpath
.metadata/
*.swp
*.swo

