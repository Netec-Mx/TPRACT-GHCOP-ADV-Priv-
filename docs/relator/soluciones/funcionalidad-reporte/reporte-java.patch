+++ b/escenario/java/src/main/java/pe/pasarelaandina/reporte/CalculadoraReporteMedios.java
@@ -0,0 +1,179 @@
+package pe.pasarelaandina.reporte;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Map;
+import java.util.TreeMap;
+
+import pe.pasarelaandina.calculo.UtilidadesFecha;
+import pe.pasarelaandina.modelo.Comercio;
+import pe.pasarelaandina.modelo.EstadoComercio;
+import pe.pasarelaandina.modelo.EstadoTransaccion;
+import pe.pasarelaandina.modelo.PlanComisiones;
+import pe.pasarelaandina.modelo.TramoComision;
+import pe.pasarelaandina.modelo.Transaccion;
+import pe.pasarelaandina.repositorio.RepositorioMemoria;
+
+/**
+ * Calcula el reporte de comisiones por medio de pago.
+ *
+ * El alcance es el mismo del cierre: comercios no dados de baja y con plan existente,
+ * transacciones aprobadas, en soles, con monto mayor que cero, fecha legible y dentro
+ * del periodo. El calculo es propio y usa decimal exacto: no reutiliza las calculadoras
+ * del cierre.
+ *
+ * Reglas aplicadas:
+ * - Comision de la transaccion: porcentaje del tramo sobre el monto completo, mas el
+ *   monto fijo, mas el recargo por cuotas (0,5 % por cuota sobre la primera, maximo
+ *   3 %) sobre esa comision base. Sin redondeo.
+ * - El limite superior de cada tramo es inclusivo: un monto igual al limite pertenece
+ *   al tramo inferior.
+ * - Filas de medios: suma exacta, redondeada a dos decimales al final.
+ * - Total: por comercio se suma exacto, se aplica el tope, se redondea y se suman los
+ *   comercios.
+ * - Ajuste por tope: en negativo, la suma de comision redondeada menos tope de los
+ *   comercios que lo superan.
+ * - Ajuste por redondeo: total menos suma de filas menos ajuste por tope.
+ */
+public class CalculadoraReporteMedios {
+
+    private static final BigDecimal CIEN = new BigDecimal("100");
+    private static final BigDecimal RECARGO_POR_CUOTA = new BigDecimal("0.5");
+    private static final BigDecimal RECARGO_MAXIMO = new BigDecimal("3");
+    private static final String MONEDA_DEL_REPORTE = "PEN";
+
+    private final UtilidadesFecha utilidadesFecha = new UtilidadesFecha();
+
+    public ReporteMediosPago calcular(RepositorioMemoria repositorio, String periodo) {
+        Date inicio = utilidadesFecha.inicioDePeriodo(periodo);
+        Date fin = utilidadesFecha.finDePeriodo(periodo);
+
+        Map<String, AcumuladoMedio> porMedio = new TreeMap<>();
+        BigDecimal total = BigDecimal.ZERO;
+        BigDecimal excesoSobreTope = BigDecimal.ZERO;
+
+        for (Comercio comercio : repositorio.getComercios()) {
+            if (comercio.getEstado() == EstadoComercio.DE_BAJA) {
+                continue;
+            }
+            PlanComisiones plan = repositorio.buscarPlanPorId(comercio.getIdPlanComisiones());
+            if (plan == null) {
+                continue;
+            }
+
+            BigDecimal comisionComercio = BigDecimal.ZERO;
+            for (Transaccion transaccion : repositorio.buscarTransaccionesDeComercio(comercio.getId())) {
+                if (!entraAlReporte(transaccion, inicio, fin)) {
+                    continue;
+                }
+                BigDecimal comision = comisionDeTransaccion(plan, transaccion);
+                comisionComercio = comisionComercio.add(comision);
+                porMedio.computeIfAbsent(transaccion.getMedioPago().name(), k -> new AcumuladoMedio())
+                        .agregar(BigDecimal.valueOf(transaccion.getMonto()), comision);
+            }
+
+            BigDecimal tope = BigDecimal.valueOf(plan.getTopeMensual());
+            if (comisionComercio.compareTo(tope) > 0) {
+                excesoSobreTope = excesoSobreTope.add(redondear(comisionComercio).subtract(tope));
+                comisionComercio = tope;
+            }
+            total = total.add(redondear(comisionComercio));
+        }
+
+        BigDecimal sumaFilas = BigDecimal.ZERO;
+        for (AcumuladoMedio acumulado : porMedio.values()) {
+            sumaFilas = sumaFilas.add(redondear(acumulado.comision));
+        }
+
+        List<ReporteMediosPago.FilaMedioPago> filas = new ArrayList<>();
+        for (Map.Entry<String, AcumuladoMedio> entrada : porMedio.entrySet()) {
+            AcumuladoMedio acumulado = entrada.getValue();
+            BigDecimal comisionFila = redondear(acumulado.comision);
+            BigDecimal participacion = sumaFilas.signum() == 0
+                    ? redondear(BigDecimal.ZERO)
+                    : comisionFila.multiply(CIEN).divide(sumaFilas, 2, RoundingMode.HALF_UP);
+            filas.add(new ReporteMediosPago.FilaMedioPago(entrada.getKey(), acumulado.cantidad,
+                    redondear(acumulado.monto), comisionFila, participacion));
+        }
+
+        total = redondear(total);
+        BigDecimal ajusteTope = redondear(excesoSobreTope.negate());
+        BigDecimal ajusteRedondeo = redondear(total.subtract(sumaFilas).subtract(ajusteTope));
+
+        return new ReporteMediosPago(periodo, inicio, fin, filas, ajusteTope, ajusteRedondeo, total);
+    }
+
+    /**
+     * Comision exacta de una transaccion, sin redondear.
+     */
+    public BigDecimal comisionDeTransaccion(PlanComisiones plan, Transaccion transaccion) {
+        BigDecimal monto = BigDecimal.valueOf(transaccion.getMonto());
+        BigDecimal porcentaje = porcentajeDelTramo(plan, monto);
+
+        BigDecimal base = monto.multiply(porcentaje).divide(CIEN)
+                .add(BigDecimal.valueOf(plan.getMontoFijoPorTransaccion()));
+
+        BigDecimal recargo = BigDecimal.ZERO;
+        if (transaccion.getCuotas() > 1) {
+            BigDecimal porcentajeRecargo = RECARGO_POR_CUOTA.multiply(BigDecimal.valueOf(transaccion.getCuotas() - 1L));
+            if (porcentajeRecargo.compareTo(RECARGO_MAXIMO) > 0) {
+                porcentajeRecargo = RECARGO_MAXIMO;
+            }
+            recargo = base.multiply(porcentajeRecargo).divide(CIEN);
+        }
+        return base.add(recargo);
+    }
+
+    /**
+     * Porcentaje del primer tramo que contiene el monto, con el limite superior inclusivo.
+     * Si ninguno lo contiene se usa el ultimo tramo, igual que el cierre.
+     */
+    private BigDecimal porcentajeDelTramo(PlanComisiones plan, BigDecimal monto) {
+        List<TramoComision> tramos = plan.getTramos();
+        for (TramoComision tramo : tramos) {
+            if (monto.compareTo(BigDecimal.valueOf(tramo.getMontoDesde())) >= 0
+                    && monto.compareTo(BigDecimal.valueOf(tramo.getMontoHasta())) <= 0) {
+                return BigDecimal.valueOf(tramo.getPorcentaje());
+            }
+        }
+        if (tramos.isEmpty()) {
+            return BigDecimal.ZERO;
+        }
+        return BigDecimal.valueOf(tramos.get(tramos.size() - 1).getPorcentaje());
+    }
+
+    private boolean entraAlReporte(Transaccion transaccion, Date inicio, Date fin) {
+        if (transaccion == null || transaccion.getFechaHora() == null) {
+            return false;
+        }
+        if (!MONEDA_DEL_REPORTE.equals(transaccion.getMoneda())) {
+            return false;
+        }
+        if (transaccion.getMonto() <= 0) {
+            return false;
+        }
+        if (transaccion.getFechaHora().before(inicio) || transaccion.getFechaHora().after(fin)) {
+            return false;
+        }
+        return transaccion.getEstado() == EstadoTransaccion.APROBADA;
+    }
+
+    private static BigDecimal redondear(BigDecimal valor) {
+        return valor.setScale(2, RoundingMode.HALF_UP);
+    }
+
+    private static final class AcumuladoMedio {
+        private int cantidad;
+        private BigDecimal monto = BigDecimal.ZERO;
+        private BigDecimal comision = BigDecimal.ZERO;
+
+        private void agregar(BigDecimal montoTransaccion, BigDecimal comisionTransaccion) {
+            cantidad++;
+            monto = monto.add(montoTransaccion);
+            comision = comision.add(comisionTransaccion);
+        }
+    }
+}
