+package pe.pasarelaandina.calculo;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+
+import org.junit.jupiter.api.Test;
+
+import pe.pasarelaandina.modelo.PlanComisiones;
+import pe.pasarelaandina.modelo.TramoComision;
+
+/**
+ * Pruebas de la seleccion de tramo de comision.
+ *
+ * Los tramos usados aqui son los del plan PL01 (ver escenario/datos/planes.txt):
+ * de 0 a 500 al 3,5 %, de 500 a 2000 al 2,9 %, de 2000 a 10000 al 2,5 % y de
+ * 10000 en adelante al 2,1 %.
+ *
+ * Nota sobre los bordes: determinarTramo compara con
+ * "monto >= montoDesde && monto <= montoHasta", así que un monto que cae
+ * justo en el limite superior de un tramo (500.00, 2000.00 o 10000.00) se
+ * queda en ese tramo, el de abajo, y no pasa al siguiente. El cierre de la
+ * liquidacion (CalculadoraLiquidacion) usa en cambio
+ * "monto >= montoDesde && monto < montoHasta", que para esos mismos montos
+ * elige el tramo siguiente. Las reglas de negocio (escenario/README.md, regla 1)
+ * dicen que se aplica "el porcentaje del tramo que corresponde a su monto"
+ * pero no precisan si el limite superior de un tramo es inclusivo o exclusivo,
+ * asi que no alcanzan para decidir cual de las dos implementaciones es la
+ * correcta. Estas pruebas documentan el comportamiento actual de
+ * determinarTramo, sin corregir la discrepancia.
+ */
+class CalculadoraComisionTest {
+
+    private final CalculadoraComision calculadora = new CalculadoraComision();
+
+    private PlanComisiones planPL01() {
+        PlanComisiones plan = new PlanComisiones("PL01", "Basico", 0.30, 8000.00);
+        plan.agregarTramo(new TramoComision(0, 500, 3.5));
+        plan.agregarTramo(new TramoComision(500, 2000, 2.9));
+        plan.agregarTramo(new TramoComision(2000, 10000, 2.5));
+        plan.agregarTramo(new TramoComision(10000, 999999, 2.1));
+        return plan;
+    }
+
+    @Test
+    void eligeElPrimerTramoParaUnMontoInteriorAEse() {
+        TramoComision tramo = calculadora.determinarTramo(planPL01(), 250.00);
+        assertEquals(3.5, tramo.getPorcentaje());
+    }
+
+    @Test
+    void eligeElSegundoTramoParaUnMontoInteriorAEse() {
+        TramoComision tramo = calculadora.determinarTramo(planPL01(), 1000.00);
+        assertEquals(2.9, tramo.getPorcentaje());
+    }
+
+    @Test
+    void eligeElTercerTramoParaUnMontoInteriorAEse() {
+        TramoComision tramo = calculadora.determinarTramo(planPL01(), 5000.00);
+        assertEquals(2.5, tramo.getPorcentaje());
+    }
+
+    @Test
+    void eligeElCuartoTramoParaUnMontoInteriorAEse() {
+        TramoComision tramo = calculadora.determinarTramo(planPL01(), 50000.00);
+        assertEquals(2.1, tramo.getPorcentaje());
+    }
+
+    @Test
+    void enElBorde500SeQuedaEnElPrimerTramoPorqueElLimiteSuperiorEsInclusivo() {
+        TramoComision tramo = calculadora.determinarTramo(planPL01(), 500.00);
+        assertEquals(3.5, tramo.getPorcentaje());
+    }
+
+    @Test
+    void enElBorde2000SeQuedaEnElSegundoTramoPorqueElLimiteSuperiorEsInclusivo() {
+        TramoComision tramo = calculadora.determinarTramo(planPL01(), 2000.00);
+        assertEquals(2.9, tramo.getPorcentaje());
+    }
+
+    @Test
+    void enElBorde10000SeQuedaEnElTercerTramoPorqueElLimiteSuperiorEsInclusivo() {
+        TramoComision tramo = calculadora.determinarTramo(planPL01(), 10000.00);
+        assertEquals(2.5, tramo.getPorcentaje());
+    }
+
+    @Test
+    void unMontoPorDebajoDelPrimerTramoCaeEnElUltimoTramoPorElValorPorDefecto() {
+        // Cuando el monto no encaja en ningun tramo del bucle (por ejemplo,
+        // por ser negativo o menor que el primer montoDesde), el metodo no
+        // devuelve null ni el primer tramo: devuelve el ULTIMO tramo de la
+        // lista como valor por defecto. Se documenta este comportamiento tal
+        // como esta hoy, sin corregirlo.
+        TramoComision tramo = calculadora.determinarTramo(planPL01(), -100.00);
+        assertEquals(2.1, tramo.getPorcentaje());
+    }
+
+    @Test
+    void unMontoPorEncimaDelUltimoTramoCaeEnElUltimoTramo() {
+        TramoComision tramo = calculadora.determinarTramo(planPL01(), 1000000.00);
+        assertEquals(2.1, tramo.getPorcentaje());
+    }
+
+    @Test
+    void unPlanSinTramosNoDevuelveNingunTramo() {
+        PlanComisiones planVacio = new PlanComisiones("PL99", "SinTramos", 0.0, 0.0);
+        TramoComision tramo = calculadora.determinarTramo(planVacio, 100.00);
+        assertNull(tramo);
+    }
+}
