+                    if (linea.MedioPago == "TARJETA_CREDITO")
+                    {
+                        montoCredito = montoCredito + linea.MontoTransaccion;
+
+                        if (linea.Cuotas > 1)
+                        {
+                            transaccionesEnCuotas++;
+                        }
+                    }
+                    else
+                    {
+                        if (linea.MedioPago == "TARJETA_DEBITO")
+                        {
+                            montoDebito = montoDebito + linea.MontoTransaccion;
