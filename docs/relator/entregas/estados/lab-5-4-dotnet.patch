+using System;
+using System.Collections.Generic;
+
+namespace Pe.PasarelaAndina.Reporte
+{
+    /// <summary>
+    /// Resultado del reporte de comisiones por medio de pago de un periodo.
+    ///
+    /// Las filas vienen ordenadas por el codigo del medio de pago. Los montos de las filas,
+    /// los ajustes y el total ya estan redondeados a dos decimales.
+    /// </summary>
+    public class ReporteMediosPago
+    {
+        public string Periodo { get; }
+        public DateTime InicioPeriodo { get; }
+        public DateTime FinPeriodo { get; }
+        public List<FilaMedioPago> Filas { get; }
+        public decimal AjustePorTope { get; }
+        public decimal AjustePorRedondeo { get; }
+        public decimal Total { get; }
+
+        public ReporteMediosPago(string periodo, DateTime inicioPeriodo, DateTime finPeriodo,
+                                 List<FilaMedioPago> filas, decimal ajustePorTope,
+                                 decimal ajustePorRedondeo, decimal total)
+        {
+            Periodo = periodo;
+            InicioPeriodo = inicioPeriodo;
+            FinPeriodo = finPeriodo;
+            Filas = filas;
+            AjustePorTope = ajustePorTope;
+            AjustePorRedondeo = ajustePorRedondeo;
+            Total = total;
+        }
+    }
+
+    /// <summary>
+    /// Una fila del reporte: lo que aporta un medio de pago a las comisiones.
+    /// </summary>
+    public class FilaMedioPago
+    {
+        public string MedioPago { get; }
+        public int CantidadTransacciones { get; }
+        public decimal MontoTransado { get; }
+        public decimal Comision { get; }
+        public decimal Participacion { get; }
+
+        public FilaMedioPago(string medioPago, int cantidadTransacciones, decimal montoTransado,
+                             decimal comision, decimal participacion)
+        {
+            MedioPago = medioPago;
+            CantidadTransacciones = cantidadTransacciones;
+            MontoTransado = montoTransado;
+            Comision = comision;
+            Participacion = participacion;
+        }
+    }
+}
diff --git a/scripts/integracion-local.sh b/scripts/integracion-local.sh
index d4a337d..94ea530 100755
--- a/scripts/integracion-local.sh
+++ b/scripts/integracion-local.sh
@@ -25,7 +25,7 @@ set -u
 readonly VERSION_SCRIPT="1.1.0"
 
 # Orden de los pasos. El workflow tiene que llamarlos en este mismo orden.
-readonly PASOS=(java dependencias-java dotnet dependencias-dotnet equivalencia)
+readonly PASOS=(java dependencias-java dotnet dependencias-dotnet equivalencia conciliacion)
 
 readonly PERIODOS=(2026-04 2026-05 2026-06)
 
@@ -160,6 +160,48 @@ paso_equivalencia() {
     [ "$fallas" -eq 0 ]
 }
 
+# Centavos enteros del monto que sigue a «S/», aunque la linea siga con texto.
+centavos() {
+    awk '{ sub(/\r$/, ""); sub(/.*S\/ /, ""); split($0, c, " "); v = c[1]; s = 1
+           if (substr(v, 1, 1) == "-") { s = -1; v = substr(v, 2) }
+           split(v, p, "."); print s * (p[1] * 100 + p[2]) }'
+}
+
+paso_conciliacion() {
+    titulo "Conciliacion: total del reporte contra las liquidaciones (stack: $stack)"
+    local periodo s fallas=0 temporal liquidado reporte diferencia
+    temporal=$(mktemp -d 2>/dev/null || mktemp -d -t conciliacion)
+    for s in java dotnet; do
+        usa "$s" || continue
+        if [ "$s" = "java" ]; then
+            (cd "$raiz/escenario/java" && mvn -q clean package -DskipTests) || { rm -rf "$temporal"; return 1; }
+        else
+            (cd "$raiz/escenario/dotnet" && dotnet build LiquidacionComercios -c Release > "$temporal/build.log") \
+                || { cat "$temporal/build.log"; rm -rf "$temporal"; return 1; }
+        fi
+        for periodo in "${PERIODOS[@]}"; do
+            liquidar "$s" "$periodo" > "$temporal/liq.txt" 2>/dev/null
+            liquidar "$s" --reporte-medios "$periodo" > "$temporal/rep.txt" 2>/dev/null
+            # Solo las lineas de cada comercio: la del resumen general lleva un espacio mas.
+            liquidado=$(grep "^  Total comisiones         : S/ " "$temporal/liq.txt" | centavos | awk '{ t += $1 } END { print t + 0 }')
+            reporte=$(grep "^Total " "$temporal/rep.txt" | centavos)
+            if [ -z "$reporte" ]; then
+                printf '  [FALLA] %s %s: el reporte no tiene fila Total\n' "$s" "$periodo"
+                fallas=$((fallas + 1)); continue
+            fi
+            diferencia=$((reporte - liquidado))
+            if [ "$diferencia" -eq 0 ]; then
+                printf '  [ OK ] %s %s concilia\n' "$s" "$periodo"
+            else
+                printf '  [FALLA] %s %s no concilia: reporte menos liquidaciones = %d centavos\n' "$s" "$periodo" "$diferencia"
+                fallas=$((fallas + 1))
+            fi
+        done
+    done
+    rm -rf "$temporal"
+    [ "$fallas" -eq 0 ]
+}
+
 correr() {
     case "$1" in
         java)                paso_java ;;
@@ -167,6 +209,7 @@ correr() {
         dotnet)              paso_dotnet ;;
         dependencias-dotnet) paso_dependencias_dotnet ;;
         equivalencia)        paso_equivalencia ;;
+        conciliacion)        paso_conciliacion ;;
         *) printf 'Paso desconocido: %s\n' "$1" >&2; return 2 ;;
     esac
 }
