diff --git a/escenario/dotnet/LiquidacionComercios/Reporte/CalculadoraReporteMedios.cs b/escenario/dotnet/LiquidacionComercios/Reporte/CalculadoraReporteMedios.cs
new file mode 100644
index 0000000..74e2f2e
--- /dev/null
+++ b/escenario/dotnet/LiquidacionComercios/Reporte/CalculadoraReporteMedios.cs
@@ -0,0 +1,215 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+
+using Pe.PasarelaAndina.Calculo;
+using Pe.PasarelaAndina.Modelo;
+using Pe.PasarelaAndina.Repositorio;
+
+namespace Pe.PasarelaAndina.Reporte
+{
+    /// <summary>
+    /// Calcula el reporte de comisiones por medio de pago.
+    ///
+    /// El alcance es el mismo del cierre: comercios no dados de baja y con plan existente,
+    /// transacciones aprobadas, en soles, con monto mayor que cero, fecha legible y dentro
+    /// del periodo. El calculo es propio y usa decimal exacto: no reutiliza las calculadoras
+    /// del cierre.
+    ///
+    /// Reglas aplicadas:
+    /// - Comision de la transaccion: porcentaje del tramo sobre el monto completo, mas el
+    ///   monto fijo, mas el recargo por cuotas (0,5 % por cuota sobre la primera, maximo
+    ///   3 %) sobre esa comision base. Sin redondeo.
+    /// - El limite superior de cada tramo es inclusivo: un monto igual al limite pertenece
+    ///   al tramo inferior.
+    /// - Filas de medios: suma exacta, redondeada a dos decimales al final.
+    /// - Total: por comercio se suma exacto, se aplica el tope, se redondea y se suman los
+    ///   comercios.
+    /// - Ajuste por tope: en negativo, la suma de comision redondeada menos tope de los
+    ///   comercios que lo superan.
+    /// - Ajuste por redondeo: total menos suma de filas menos ajuste por tope.
+    /// </summary>
+    public class CalculadoraReporteMedios
+    {
+        private const decimal Cien = 100m;
+        private const decimal RecargoPorCuota = 0.5m;
+        private const decimal RecargoMaximo = 3m;
+        private const string MonedaDelReporte = "PEN";
+
+        private readonly UtilidadesFecha utilidadesFecha = new UtilidadesFecha();
+
+        public ReporteMediosPago Calcular(RepositorioMemoria repositorio, string periodo)
+        {
+            DateTime inicio = utilidadesFecha.InicioDePeriodo(periodo);
+            DateTime fin = utilidadesFecha.FinDePeriodo(periodo);
+
+            SortedDictionary<string, AcumuladoMedio> porMedio =
+                    new SortedDictionary<string, AcumuladoMedio>(StringComparer.Ordinal);
+            decimal total = 0m;
+            decimal excesoSobreTope = 0m;
+
+            foreach (Comercio comercio in repositorio.Comercios)
+            {
+                if (comercio.Estado == EstadoComercio.DE_BAJA)
+                {
+                    continue;
+                }
+                PlanComisiones plan = repositorio.BuscarPlanPorId(comercio.IdPlanComisiones);
+                if (plan == null)
+                {
+                    continue;
+                }
+
+                decimal comisionComercio = 0m;
+                foreach (Transaccion transaccion in repositorio.BuscarTransaccionesDeComercio(comercio.Id))
+                {
+                    if (!EntraAlReporte(transaccion, inicio, fin))
+                    {
+                        continue;
+                    }
+                    decimal comision = ComisionDeTransaccion(plan, transaccion);
+                    comisionComercio += comision;
+                    string medio = transaccion.MedioPago.ToString();
+                    AcumuladoMedio acumulado;
+                    if (!porMedio.TryGetValue(medio, out acumulado))
+                    {
+                        acumulado = new AcumuladoMedio();
+                        porMedio[medio] = acumulado;
+                    }
+                    acumulado.Agregar(ADecimal(transaccion.Monto), comision);
+                }
+
+                decimal tope = ADecimal(plan.TopeMensual);
+                if (comisionComercio > tope)
+                {
+                    excesoSobreTope += Redondear(comisionComercio) - tope;
+                    comisionComercio = tope;
+                }
+                total += Redondear(comisionComercio);
+            }
+
+            decimal sumaFilas = 0m;
+            foreach (AcumuladoMedio acumulado in porMedio.Values)
+            {
+                sumaFilas += Redondear(acumulado.Comision);
+            }
+
+            List<FilaMedioPago> filas = new List<FilaMedioPago>();
+            foreach (KeyValuePair<string, AcumuladoMedio> entrada in porMedio)
+            {
+                AcumuladoMedio acumulado = entrada.Value;
+                decimal comisionFila = Redondear(acumulado.Comision);
+                decimal participacion = sumaFilas == 0m
+                        ? Redondear(0m)
+                        : Redondear(comisionFila * Cien / sumaFilas);
+                filas.Add(new FilaMedioPago(entrada.Key, acumulado.Cantidad,
+                        Redondear(acumulado.Monto), comisionFila, participacion));
+            }
+
+            total = Redondear(total);
+            decimal ajusteTope = Redondear(-excesoSobreTope);
+            decimal ajusteRedondeo = Redondear(total - sumaFilas - ajusteTope);
+
+            return new ReporteMediosPago(periodo, inicio, fin, filas, ajusteTope, ajusteRedondeo, total);
+        }
+
+        /// <summary>
+        /// Comision exacta de una transaccion, sin redondear.
+        /// </summary>
+        public decimal ComisionDeTransaccion(PlanComisiones plan, Transaccion transaccion)
+        {
+            decimal monto = ADecimal(transaccion.Monto);
+            decimal porcentaje = PorcentajeDelTramo(plan, monto);
+
+            decimal baseComision = monto * porcentaje / Cien + ADecimal(plan.MontoFijoPorTransaccion);
+
+            decimal recargo = 0m;
+            if (transaccion.Cuotas > 1)
+            {
+                decimal porcentajeRecargo = RecargoPorCuota * (transaccion.Cuotas - 1);
+                if (porcentajeRecargo > RecargoMaximo)
+                {
+                    porcentajeRecargo = RecargoMaximo;
+                }
+                recargo = baseComision * porcentajeRecargo / Cien;
+            }
+            return baseComision + recargo;
+        }
+
+        /// <summary>
+        /// Porcentaje del primer tramo que contiene el monto, con el limite superior inclusivo.
+        /// Si ninguno lo contiene se usa el ultimo tramo, igual que el cierre.
+        /// </summary>
+        private static decimal PorcentajeDelTramo(PlanComisiones plan, decimal monto)
+        {
+            List<TramoComision> tramos = plan.Tramos;
+            foreach (TramoComision tramo in tramos)
+            {
+                if (monto >= ADecimal(tramo.MontoDesde) && monto <= ADecimal(tramo.MontoHasta))
+                {
+                    return ADecimal(tramo.Porcentaje);
+                }
+            }
+            if (tramos.Count == 0)
+            {
+                return 0m;
+            }
+            return ADecimal(tramos[tramos.Count - 1].Porcentaje);
+        }
+
+        private static bool EntraAlReporte(Transaccion transaccion, DateTime inicio, DateTime fin)
+        {
+            if (transaccion == null || transaccion.FechaHora == DateTime.MinValue)
+            {
+                return false;
+            }
+            if (!MonedaDelReporte.Equals(transaccion.Moneda))
+            {
+                return false;
+            }
+            if (transaccion.Monto <= 0)
+            {
+                return false;
+            }
+            if (transaccion.FechaHora < inicio || transaccion.FechaHora > fin)
+            {
+                return false;
+            }
+            return transaccion.Estado == EstadoTransaccion.APROBADA;
+        }
+
+        /// <summary>
+        /// Convierte un double a decimal con su representacion decimal mas corta, igual que
+        /// BigDecimal.valueOf en Java. La conversion directa de C# conserva solo quince
+        /// digitos significativos.
+        /// </summary>
+        private static decimal ADecimal(double valor)
+        {
+            return decimal.Parse(valor.ToString("R", CultureInfo.InvariantCulture),
+                    NumberStyles.Float, CultureInfo.InvariantCulture);
+        }
+
+        /// <summary>
+        /// Dos decimales, medio hacia arriba. AwayFromZero coincide con HALF_UP de Java
+        /// tambien en los negativos.
+        /// </summary>
+        private static decimal Redondear(decimal valor)
+        {
+            return Math.Round(valor, 2, MidpointRounding.AwayFromZero);
+        }
+
+        private sealed class AcumuladoMedio
+        {
+            public int Cantidad;
+            public decimal Monto;
+            public decimal Comision;
+
+            public void Agregar(decimal montoTransaccion, decimal comisionTransaccion)
+            {
+                Cantidad++;
+                Monto += montoTransaccion;
+                Comision += comisionTransaccion;
+            }
+        }
+    }
+}
diff --git a/escenario/dotnet/LiquidacionComercios/Reporte/FormateadorReporteMedios.cs b/escenario/dotnet/LiquidacionComercios/Reporte/FormateadorReporteMedios.cs
new file mode 100644
index 0000000..877e6fe
--- /dev/null
+++ b/escenario/dotnet/LiquidacionComercios/Reporte/FormateadorReporteMedios.cs
@@ -0,0 +1,87 @@
+using System;
+using System.Globalization;
+using System.Text;
+
+namespace Pe.PasarelaAndina.Reporte
+{
+    /// <summary>
+    /// Arma el texto del reporte de comisiones por medio de pago.
+    ///
+    /// Formato fijo, con fin de linea \n:
+    ///
+    /// - Encabezado con el marco de 58 signos = y fechas dd/MM/yyyy HH:mm, igual que la
+    ///   liquidacion.
+    /// - Tabla de columnas de ancho fijo, separadas por los propios anchos:
+    ///     Medio de pago   15 caracteres, alineado a la izquierda
+    ///     Transacciones   16 caracteres, alineado a la derecha
+    ///     Monto transado  18 caracteres, alineado a la derecha
+    ///     Comision        16 caracteres, alineado a la derecha
+    ///     Participacion   16 caracteres, alineado a la derecha
+    ///   Ancho total de la tabla: 81 caracteres.
+    /// - Separador de 81 guiones despues de las filas de medios.
+    /// - Filas de ajuste y total: etiqueta de 49 caracteres alineada a la izquierda (el
+    ///   ancho de las tres primeras columnas) y el monto en la columna Comision, 16
+    ///   caracteres alineado a la derecha.
+    /// - Montos como "S/ " seguido del valor con punto decimal, dos decimales y sin
+    ///   separador de miles; el signo negativo va despues del prefijo.
+    /// - Porcentajes con dos decimales y el sufijo " %".
+    /// </summary>
+    public class FormateadorReporteMedios
+    {
+        private const string Marco =
+                "==========================================================";
+        private const string FormatoFila = "{0,-15}{1,16}{2,18}{3,16}{4,16}\n";
+        private const string FormatoPie = "{0,-49}{1,16}\n";
+        private static readonly string Separador = new string('-', 81);
+        private const string FormatoFecha = "dd/MM/yyyy HH:mm";
+
+        public string Formatear(ReporteMediosPago reporte)
+        {
+            CultureInfo cultura = CultureInfo.InvariantCulture;
+
+            StringBuilder texto = new StringBuilder();
+            texto.Append(Marco).Append('\n');
+            texto.Append("  PASARELA ANDINA - COMISIONES POR MEDIO DE PAGO\n");
+            texto.Append("  Periodo: ").Append(reporte.Periodo).Append('\n');
+            texto.Append("  Desde: ").Append(reporte.InicioPeriodo.ToString(FormatoFecha, cultura)).Append('\n');
+            texto.Append("  Hasta: ").Append(reporte.FinPeriodo.ToString(FormatoFecha, cultura)).Append('\n');
+            texto.Append(Marco).Append('\n');
+            texto.Append('\n');
+
+            texto.Append(string.Format(cultura, FormatoFila,
+                    "Medio de pago", "Transacciones", "Monto transado", "Comision", "Participacion"));
+
+            foreach (FilaMedioPago fila in reporte.Filas)
+            {
+                texto.Append(string.Format(cultura, FormatoFila,
+                        fila.MedioPago,
+                        fila.CantidadTransacciones.ToString(cultura),
+                        Monto(fila.MontoTransado),
+                        Monto(fila.Comision),
+                        Porcentaje(fila.Participacion)));
+            }
+
+            texto.Append(Separador).Append('\n');
+            texto.Append(string.Format(cultura, FormatoPie, "Ajuste por tope", Monto(reporte.AjustePorTope)));
+            texto.Append(string.Format(cultura, FormatoPie, "Ajuste por redondeo", Monto(reporte.AjustePorRedondeo)));
+            texto.Append(string.Format(cultura, FormatoPie, "Total", Monto(reporte.Total)));
+            return texto.ToString();
+        }
+
+        internal static string Monto(decimal valor)
+        {
+            return "S/ " + DosDecimales(valor);
+        }
+
+        internal static string Porcentaje(decimal valor)
+        {
+            return DosDecimales(valor) + " %";
+        }
+
+        private static string DosDecimales(decimal valor)
+        {
+            return Math.Round(valor, 2, MidpointRounding.AwayFromZero)
+                    .ToString("0.00", CultureInfo.InvariantCulture);
+        }
+    }
+}
