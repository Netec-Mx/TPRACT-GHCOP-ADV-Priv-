+package pe.pasarelaandina.reporte;
+
+import java.math.BigDecimal;
+import java.util.Date;
+import java.util.List;
+
+/**
+ * Resultado del reporte de comisiones por medio de pago de un periodo.
+ *
+ * Las filas vienen ordenadas por el codigo del medio de pago. Los montos de las filas,
+ * los ajustes y el total ya estan redondeados a dos decimales.
+ */
+public record ReporteMediosPago(
+        String periodo,
+        Date inicioPeriodo,
+        Date finPeriodo,
+        List<FilaMedioPago> filas,
+        BigDecimal ajustePorTope,
+        BigDecimal ajustePorRedondeo,
+        BigDecimal total) {
+
+    /**
+     * Una fila del reporte: lo que aporta un medio de pago a las comisiones.
+     */
+    public record FilaMedioPago(
+            String medioPago,
+            int cantidadTransacciones,
+            BigDecimal montoTransado,
+            BigDecimal comision,
+            BigDecimal participacion) {
+    }
+}
diff --git a/escenario/java/src/test/java/pe/pasarelaandina/reporte/CalculadoraReporteMediosTest.java b/escenario/java/src/test/java/pe/pasarelaandina/reporte/CalculadoraReporteMediosTest.java
new file mode 100644
index 0000000..3eaa58f
