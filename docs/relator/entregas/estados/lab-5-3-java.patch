+++ b/escenario/java/src/test/java/pe/pasarelaandina/reporte/CalculadoraReporteMediosTest.java
@@ -0,0 +1,224 @@
+package pe.pasarelaandina.reporte;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.Date;
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import pe.pasarelaandina.calculo.UtilidadesFecha;
+import pe.pasarelaandina.modelo.CategoriaNegocio;
+import pe.pasarelaandina.modelo.Comercio;
+import pe.pasarelaandina.modelo.EstadoComercio;
+import pe.pasarelaandina.modelo.EstadoTransaccion;
+import pe.pasarelaandina.modelo.MedioPago;
+import pe.pasarelaandina.modelo.PlanComisiones;
+import pe.pasarelaandina.modelo.TramoComision;
+import pe.pasarelaandina.modelo.Transaccion;
+import pe.pasarelaandina.repositorio.RepositorioMemoria;
+
+/**
+ * Pruebas del calculo del reporte de comisiones por medio de pago, con datos en memoria.
+ */
+class CalculadoraReporteMediosTest {
+
+    private static final String PERIODO = "2026-06";
+
+    private final UtilidadesFecha utilidadesFecha = new UtilidadesFecha();
+    private final CalculadoraReporteMedios calculadora = new CalculadoraReporteMedios();
+    private RepositorioMemoria repositorio;
+    private int secuencia;
+
+    @BeforeEach
+    void prepararRepositorio() {
+        repositorio = new RepositorioMemoria();
+        secuencia = 0;
+        PlanComisiones plan = new PlanComisiones("PL01", "Basico", 0.30, 8000.00);
+        plan.agregarTramo(new TramoComision(0, 500, 3.5));
+        plan.agregarTramo(new TramoComision(500, 2000, 2.9));
+        plan.agregarTramo(new TramoComision(2000, 999999, 2.5));
+        repositorio.agregarPlan(plan);
+
+        PlanComisiones planConTopeBajo = new PlanComisiones("PL02", "Tope bajo", 0.30, 10.00);
+        planConTopeBajo.agregarTramo(new TramoComision(0, 500, 3.5));
+        planConTopeBajo.agregarTramo(new TramoComision(500, 999999, 2.9));
+        repositorio.agregarPlan(planConTopeBajo);
+
+        PlanComisiones planSinFijo = new PlanComisiones("PL03", "Sin fijo", 0.0, 8000.00);
+        planSinFijo.agregarTramo(new TramoComision(0, 999999, 1.0));
+        repositorio.agregarPlan(planSinFijo);
+    }
+
+    @Test
+    void unMontoIgualAlLimiteSuperiorPagaElTramoInferior() {
+        comercio("CM0001", EstadoComercio.ACTIVO, "PL01");
+        transaccion("CM0001", 500.00, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.APROBADA);
+
+        ReporteMediosPago reporte = calculadora.calcular(repositorio, PERIODO);
+
+        // 500.00 x 3,5 % + 0,30 = 17,80; con el tramo siguiente serian 14,80.
+        assertEquals(new BigDecimal("17.80"), reporte.filas().get(0).comision());
+        assertEquals(new BigDecimal("17.80"), reporte.total());
+    }
+
+    @Test
+    void unaTransaccionAnuladaNoCuenta() {
+        comercio("CM0001", EstadoComercio.ACTIVO, "PL01");
+        transaccion("CM0001", 100.00, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.APROBADA);
+        transaccion("CM0001", 300.00, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.ANULADA);
+        transaccion("CM0001", 300.00, MedioPago.BILLETERA_MOVIL, 1, EstadoTransaccion.ANULADA);
+
+        ReporteMediosPago reporte = calculadora.calcular(repositorio, PERIODO);
+
+        assertEquals(1, reporte.filas().size());
+        ReporteMediosPago.FilaMedioPago fila = reporte.filas().get(0);
+        assertEquals("TARJETA_DEBITO", fila.medioPago());
+        assertEquals(1, fila.cantidadTransacciones());
+        assertEquals(new BigDecimal("100.00"), fila.montoTransado());
+        assertEquals(new BigDecimal("3.80"), fila.comision());
+    }
+
+    @Test
+    void quedanFueraLasPendientesRechazadasYComerciosDeBaja() {
+        comercio("CM0001", EstadoComercio.ACTIVO, "PL01");
+        comercio("CM0002", EstadoComercio.DE_BAJA, "PL01");
+        comercio("CM0003", EstadoComercio.SUSPENDIDO, "PL01");
+        comercio("CM0004", EstadoComercio.ACTIVO, "PL99");
+        transaccion("CM0001", 100.00, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.PENDIENTE);
+        transaccion("CM0001", 100.00, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.RECHAZADA);
+        transaccion("CM0002", 100.00, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.APROBADA);
+        transaccion("CM0003", 100.00, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.APROBADA);
+        transaccion("CM0004", 100.00, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.APROBADA);
+
+        ReporteMediosPago reporte = calculadora.calcular(repositorio, PERIODO);
+
+        assertEquals(1, reporte.filas().get(0).cantidadTransacciones());
+        assertEquals(new BigDecimal("3.80"), reporte.total());
+    }
+
+    @Test
+    void unaTransaccionEnCuotasLlevaRecargoSobreLaComisionBase() {
+        comercio("CM0001", EstadoComercio.ACTIVO, "PL01");
+        Transaccion enCuatroCuotas =
+                transaccion("CM0001", 100.00, MedioPago.TARJETA_CREDITO, 4, EstadoTransaccion.APROBADA);
+        Transaccion enDoceCuotas =
+                transaccion("CM0001", 100.00, MedioPago.TARJETA_CREDITO, 12, EstadoTransaccion.APROBADA);
+        PlanComisiones plan = repositorio.buscarPlanPorId("PL01");
+
+        // Base 3,80; recargo de 1,5 % por tres cuotas sobre la primera.
+        assertEquals(0, new BigDecimal("3.857").compareTo(
+                calculadora.comisionDeTransaccion(plan, enCuatroCuotas)));
+        // Once cuotas sobre la primera darian 5,5 %, pero el maximo es 3 %.
+        assertEquals(0, new BigDecimal("3.914").compareTo(
+                calculadora.comisionDeTransaccion(plan, enDoceCuotas)));
+
+        ReporteMediosPago reporte = calculadora.calcular(repositorio, PERIODO);
+        assertEquals(new BigDecimal("7.77"), reporte.filas().get(0).comision());
+    }
+
+    @Test
+    void unComercioQueSuperaElTopeCobraElTopeYSeMuestraElAjuste() {
+        comercio("CM0001", EstadoComercio.ACTIVO, "PL02");
+        transaccion("CM0001", 500.00, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.APROBADA);
+
+        ReporteMediosPago reporte = calculadora.calcular(repositorio, PERIODO);
+
+        // La fila muestra la comision antes del tope; el ajuste descuenta el exceso.
+        assertEquals(new BigDecimal("17.80"), reporte.filas().get(0).comision());
+        assertEquals(new BigDecimal("-7.80"), reporte.ajustePorTope());
+        assertEquals(new BigDecimal("0.00"), reporte.ajustePorRedondeo());
+        assertEquals(new BigDecimal("10.00"), reporte.total());
+    }
+
+    @Test
+    void elTotalEsLaSumaPorComercioConTopeYElRedondeoQuedaEnSuAjuste() {
+        comercio("CM0001", EstadoComercio.ACTIVO, "PL01");
+        comercio("CM0002", EstadoComercio.ACTIVO, "PL02");
+        comercio("CM0003", EstadoComercio.ACTIVO, "PL03");
+        transaccion("CM0001", 100.00, MedioPago.TARJETA_CREDITO, 1, EstadoTransaccion.APROBADA);
+        transaccion("CM0002", 500.00, MedioPago.TARJETA_CREDITO, 1, EstadoTransaccion.APROBADA);
+        // 0,50 x 1 % = 0,005 por transaccion: cada fila redondea a 0,01 pero el comercio
+        // suma 0,01 exacto.
+        transaccion("CM0003", 0.50, MedioPago.BILLETERA_MOVIL, 1, EstadoTransaccion.APROBADA);
+        transaccion("CM0003", 0.50, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.APROBADA);
+
+        ReporteMediosPago reporte = calculadora.calcular(repositorio, PERIODO);
+
+        // CM0001 3,80 + CM0002 con tope 10,00 + CM0003 0,01.
+        assertEquals(new BigDecimal("13.81"), reporte.total());
+        assertEquals(new BigDecimal("-7.80"), reporte.ajustePorTope());
+        assertEquals(new BigDecimal("-0.01"), reporte.ajustePorRedondeo());
+
+        BigDecimal sumaFilas = BigDecimal.ZERO;
+        for (ReporteMediosPago.FilaMedioPago fila : reporte.filas()) {
+            sumaFilas = sumaFilas.add(fila.comision());
+        }
+        assertEquals(reporte.total(),
+                sumaFilas.add(reporte.ajustePorTope()).add(reporte.ajustePorRedondeo()));
+    }
+
+    @Test
+    void lasFilasVanOrdenadasPorCodigoYLlevanSuParticipacion() {
+        comercio("CM0001", EstadoComercio.ACTIVO, "PL03");
+        transaccion("CM0001", 100.00, MedioPago.TRANSFERENCIA, 1, EstadoTransaccion.APROBADA);
+        transaccion("CM0001", 200.00, MedioPago.BILLETERA_MOVIL, 1, EstadoTransaccion.APROBADA);
+
+        ReporteMediosPago reporte = calculadora.calcular(repositorio, PERIODO);
+
+        assertEquals("BILLETERA_MOVIL", reporte.filas().get(0).medioPago());
+        assertEquals("TRANSFERENCIA", reporte.filas().get(1).medioPago());
+        assertEquals(new BigDecimal("66.67"), reporte.filas().get(0).participacion());
+        assertEquals(new BigDecimal("33.33"), reporte.filas().get(1).participacion());
+    }
+
+    @Test
+    void elFormatoMuestraMontosConPrefijoYAjustesSiempre() {
+        comercio("CM0001", EstadoComercio.ACTIVO, "PL02");
+        transaccion("CM0001", 500.00, MedioPago.TARJETA_DEBITO, 1, EstadoTransaccion.APROBADA);
+
+        String texto = new FormateadorReporteMedios().formatear(calculadora.calcular(repositorio, PERIODO));
+
+        // Anchos: 15, 16, 18, 16 y 16 en las filas; 49 y 16 en el pie.
+        assertTrue(texto.contains("TARJETA_DEBITO " + " ".repeat(15) + "1" + " ".repeat(9) + "S/ 500.00"
+                + " ".repeat(8) + "S/ 17.80" + " ".repeat(8) + "100.00 %\n"));
+        assertTrue(texto.contains("Ajuste por tope" + " ".repeat(34 + 8) + "S/ -7.80\n"));
+        assertTrue(texto.contains("Ajuste por redondeo" + " ".repeat(30 + 9) + "S/ 0.00\n"));
+        assertTrue(texto.endsWith("Total" + " ".repeat(44 + 8) + "S/ 10.00\n"));
+    }
+
+    @Test
+    void elFormatoRedondeaElMedioCentavoHaciaArribaYNoSeparaLosMiles() {
+        Date inicio = utilidadesFecha.parsearFechaHora("2026-06-01 00:00:00");
+        Date fin = utilidadesFecha.parsearFechaHora("2026-06-30 23:59:59");
+        ReporteMediosPago reporte = new ReporteMediosPago(PERIODO, inicio, fin,
+                List.of(new ReporteMediosPago.FilaMedioPago("TARJETA_CREDITO", 3,
+                        new BigDecimal("12345.6"), new BigDecimal("957.185"), new BigDecimal("100"))),
+                BigDecimal.ZERO, BigDecimal.ZERO, new BigDecimal("957.185"));
+
+        String texto = new FormateadorReporteMedios().formatear(reporte);
+
+        assertTrue(texto.contains("S/ 957.19"), "medio centavo, medio hacia arriba");
+        assertTrue(texto.contains("S/ 12345.60"), "miles sin separador");
+        assertFalse(texto.contains("12,345") || texto.contains("12.345,"), "sin separador de miles");
+    }
+
+    private void comercio(String id, EstadoComercio estado, String idPlan) {
+        repositorio.agregarComercio(new Comercio(id, "Comercio " + id, "20123456789",
+                CategoriaNegocio.values()[0], utilidadesFecha.parsearFecha("2020-01-01"), estado, idPlan));
+    }
+
+    private Transaccion transaccion(String idComercio, double monto, MedioPago medio, int cuotas,
+                                    EstadoTransaccion estado) {
+        secuencia++;
+        Date fecha = utilidadesFecha.parsearFechaHora("2026-06-15 10:00:00");
+        Transaccion transaccion = new Transaccion("TX" + secuencia, idComercio, monto, "PEN",
+                fecha, medio, cuotas, estado, "AUT" + secuencia);
+        repositorio.agregarTransaccion(transaccion);
+        return transaccion;
+    }
+}
